
#include <iostream>
using namespace std;

int main() {
    int number;

    // Ask the user to enter a number
    cout << "Enter any number: ";
    cin >> number;

    // Check whether the number is even or odd
    if (number % 2 == 0) {
        cout << number << " is an Even number." << endl;
    }
    else {
        cout << number << " is an Odd number." << endl;
    }

    cout << "Thank you for using this program!" << endl;

    return 0;
}
